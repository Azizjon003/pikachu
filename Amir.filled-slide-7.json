    {
      "type": "shape",
      "content": "O'smalar va ularning ta'siri",
      "elementIndex": 15
    },
    {
      "type": "shape",
      "content": "O'smalar har qanday organizmda muhim ro'l o'ynaydi. Ular o'sish, rivojlanish va hayot jarayonlarida ishtirok etadilar.",
      "elementIndex": 17
    },
    {
      "type": "shape",
      "content": "O'smalarni tasniflash",
      "elementIndex": 19
    },
    {
      "type": "shape",
      "content": "O'smalar bir nechta guruhlarga bo'linadi: o'simliklar, hayvonlar, va mikroorganizmlar. Har bir guruh o'ziga xos xususiyatlarga ega.",
      "elementIndex": 21
    },
    {
      "type": "shape",
      "content": "O'smalar va ularning foydalari",
      "elementIndex": 23
    },
    {
      "type": "shape",
      "content": "O'smalar inson hayotida ko'plab foydali xususiyatlarga ega: oziq-ovqat manbai, dori-darmon, va ekotizimni saqlashda yordam.",
      "elementIndex": 25
    },
    {
      "type": "shape",
      "content": "O'smalar orqali ta'sir",
      "elementIndex": 27
    },
    {
      "type": "shape",
      "content": "O'smalar atrof-muhitga ta'sir qiladi, ularning yo'qolishi ekosistemalarga xavf tug'diradi. Shuningdek, o'smalar odamlar hayotida ham muhimdir.",
      "elementIndex": 29
    },
    {
      "type": "shape",
      "content": "O'smalar va zamonaviy tadqiqotlar",
      "elementIndex": 31
    }
  ],
