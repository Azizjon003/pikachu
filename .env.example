# ===========================================
# PIKACHU API - Environment Configuration
# ===========================================

# ============================================
# AI Provider Configuration (Choose ONE)
# ============================================

# OPTION 1: OpenAI (Official API)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_api_key_here

# OPTION 2: Azure OpenAI (Recommended for Production)
# Get your endpoint and key from Azure Portal
AZURE_OPENAI_ENDPOINT=https://magicslide-api.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# NOTE: If both are set, Azure OpenAI will be used as priority
# The centralized OpenAI service will automatically detect which provider to use

# Server Configuration
PORT=3000
NODE_ENV=development

# API Security
# Generate a secure random API key for authentication
# Leave empty to disable API key authentication
API_KEY=your_secure_api_key_here

# CORS Configuration
# Comma-separated list of allowed origins
# Use '*' to allow all origins (not recommended for production)
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=*

# Rate Limiting Configuration (optional)
# Uncomment and modify if you want to customize rate limits
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# STRICT_RATE_LIMIT_MAX_REQUESTS=10
# UPLOAD_RATE_LIMIT_MAX_REQUESTS=20

# Logging Configuration (optional)
LOG_LEVEL=info
