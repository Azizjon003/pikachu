      }
    },
    {
      "elementIndex": 15,
      "content": "O'sma xastaligi xavfi",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 16,
      "content": "Profilaktika darajasi",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 17,
      "content": "Sog'lom turmush tarzining ta'siri",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 18,
      "content": "O'smalarni profilaktika qilishda erkaklar va ayollarning o'ziga xos xususiyatlari mavjud. Shaxsiy sog'liqni nazorat qilish, muntazam tibbiy ko'riklar o'tkazish va to'g'ri ovqatlanish muhim ahamiyatga ega.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 19,
      "content": "O'smalarni erta aniqlash va davolash, xavf omillarini kamaytirish va sog'lom turmush tarzini qo'llash - bu o'smalarni oldini olishning muhim qismidir.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 20,
      "content": "O'smalarni profilaktika qilishda jismoniy faollik, stressni boshqarish va to'g'ri ovqatlanish kabi omillarni hisobga olish zarur.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 21,
      "content": "O'smalarni erta aniqlash: Muntazam tibbiy tekshiruvlar",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 22,
      "content": "Oziqlanish: Sog'lom ovqatlanish odatlari",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 23,
      "content": "Jismoniy faollik: Harakatli turmush tarzi",
      "tableData": {
        "data": []
      }
    }
  ]
}