      },
      {
        "type": "shape",
        "width": 179.92125984251965,
        "height": 128.66362204724408,
        "left": 74.11044619422572,
        "top": 411.33637795275587,
        "content": "Armiya, milliy xavfsizlikni ta'minlaydi va strategik mudofaa vazifalarini bajaradi. Harbiy tayyorgarliklar muntazam ravishda o'tkaziladi.",
        "fontSize": 13,
        "maxCharacters": 220,
