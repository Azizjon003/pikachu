      },
      {
        "type": "shape",
        "width": 202.2468241469816,
        "height": 128.66362204724408,
        "left": 370.9137007874015,
        "top": 411.33637795275587,
        "content": "Yuqori malakali mutaxassislar tomonidan boshqariladigan armiyaning vazifalari, mamlakat ichki va tashqi tahdidlardan himoya qilishdir. Harbiy strategiyalar doimiy ravishda yangilanadi.",
        "fontSize": 13,
        "maxCharacters": 240,
        "elementIndex": 33
      },
      {
