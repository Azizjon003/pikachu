      },
      {
        "type": "shape",
        "width": 198.52587926509185,
        "height": 97.92230971128608,
        "left": 74.11044619422572,
        "top": 228.45784776902886,
        "content": "O'zbekiston armiyasi milliy xavfsizlikni ta'minlash, davlat chegarasini himoya qilish va ichki tartibni saqlash uchun tashkil etilgan.",
        "fontSize": 13,
        "maxCharacters": 180,
        "elementIndex": 25
      },
      {
        "type": "shape",
        "width": 179.92125984251965,
        "height": 128.66362204724408,
        "left": 74.11044619422572,
        "top": 411.33637795275587,
        "content": "Armiyaning asosiy vazifalari ichki va tashqi tahdidlarga qarshi kurash, tinchlikni saqlash va xalqaro missiyalarda ishtirok etishni o'z ichiga oladi.",
        "fontSize": 13,
        "maxCharacters": 220,
        "elementIndex": 29
      },
      {
        "type": "shape",
        "width": 202.2468241469816,
        "height": 128.66362204724408,
        "left": 370.9137007874015,
        "top": 411.33637795275587,
        "content": "O'zbekiston armiyasi zamonaviy qurollar va texnologiyalar bilan jihozlangan. Harbiy tayyorgarlik va ma'lumotlarni oshirish ustuvor vazifalardir.",
        "fontSize": 13,
        "maxCharacters": 240,
        "elementIndex": 33
      },
      {
        "type": "shape",
        "width": 218.3709186351706,
        "height": 90.97700787401574,
        "left": 364.7122309711286,
        "top": 215.55821522309708,
        "content": "Milliy armiyaning rivojlanishi va harbiy qobiliyatlarini oshirish uchun doimiy ravishda yangi dasturlar va loyihalar amalga oshirilmoqda.",
        "fontSize": 13,
        "maxCharacters": 162,
        "elementIndex": 37
      },
      {
        "type": "shape",
        "width": 300,
        "height": 25,
        "left": 0,
        "top": 0,
        "content": "Armiyaning vazifalari va roli",
        "fontSize": 8,
        "maxCharacters": 148,
        "elementIndex": 41
      }
    ],
    "note": ""
