        "left": 147.13721784776902,
        "top": 16.931653543307085,
        "content": "Tumor Tasnifi Tushuntirish",
        "fontSize": 40,
        "maxCharacters": 32,
        "elementIndex": 5
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 224.64881889763777,
        "content": "Tumorlar organizmda hujayralarning nazoratsiz o'sishi natijasida paydo bo'ladi.",
        "fontSize": 13,
        "maxCharacters": 64,
        "elementIndex": 9
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 676.7618897637794,
        "top": 159.58414698162727,
        "content": "Asosiy turdagi tumorlar: benign va malign.",
        "fontSize": 15,
        "maxCharacters": 27,
        "elementIndex": 13
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 411.93784776902885,
        "content": "Malign tumorlar: saraton hujayralari o'sib, boshqa to'qimalarga tarqaladi.",
        "fontSize": 13,
        "maxCharacters": 64,
        "elementIndex": 17
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 680.4828346456692,
        "top": 347.24094488188973,
        "content": "Benign tumorlar: o'sish tezligi sekin, boshqa to'qimalarga tarqalmaydi.",
        "fontSize": 15,
        "maxCharacters": 27,
        "elementIndex": 21
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 211.92787401574802,
        "content": "Tumorlarning klassifikatsiyasi: joylashuvi, turiga ko'ra.",
        "fontSize": 13,
        "maxCharacters": 64,
        "elementIndex": 25
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 63.03128608923883,
        "top": 152.95191601049868,
        "content": "O'simta turlari: sarkoma, karcinoma, leiomiyoma.",
        "fontSize": 15,
        "maxCharacters": 27,
        "elementIndex": 29
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 405.93784776902885,
        "content": "Tumorlar o'zaro turlicha belgilarga ega, ko'p holatda alomatlar paydo bo'ladi.",
        "fontSize": 13,
        "maxCharacters": 64,
        "elementIndex": 33
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 50.62813648293963,
        "top": 347.24094488188973,
        "content": "Tashxis va davolash usullari: jarrohlik, kimyoterapiya, radiatsiya.",
        "fontSize": 15,
        "maxCharacters": 27,
        "elementIndex": 37
      }
    ],
    "note": ""
  },
