      {
        "type": "shape",
        "width": 776.4724409448818,
        "height": 58,
        "left": 91.76293963254592,
        "top": 20.76850393700787,
        "content": "Tumor Turlari va Belgilari",
        "fontSize": 40,
        "maxCharacters": 38,
        "elementIndex": 40
      },
      {
        "type": "shape",
        "width": 238.25102362204723,
        "height": 63.390656167978996,
        "left": 68.36514435695537,
        "top": 155.26225721784775,
        "content": "Tumorlar organizmda to'qimalarning o'sishi natijasida paydo bo'ladi. Ular yaxshi yoki yomon bo'lishi mumkin.",
        "fontSize": 13,
        "maxCharacters": 144,
        "elementIndex": 44
      },
      {
        "type": "shape",
        "width": 232.7155905511811,
        "height": 63.390656167978996,
        "left": 355.4745406824146,
        "top": 161.46383202099736,
        "content": "Yomon o'simliklar tez sur'atlarda o'sadi va atrofdagi to'qimalarga zarar etkazadi. Belgilari orasida og'riq, shish va qon ketish bor.",
        "fontSize": 13,
        "maxCharacters": 139,
        "elementIndex": 48
      },
      {
        "type": "shape",
        "width": 233.99611548556427,
        "height": 63.390656167978996,
        "left": 654.5164304461941,
        "top": 167.66540682414697,
        "content": "Yaxshi o'simliklar esa sekin o'sadi va ko'pincha asoratlar keltirib chiqarmaydi. Ularning belgilari kamroq sezilarli bo'lishi mumkin.",
        "fontSize": 13,
        "maxCharacters": 139,
        "elementIndex": 52
      }
    ],
    "note": ""
  },
