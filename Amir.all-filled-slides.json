        "top": 16.931653543307085,
        "content": "O'sma turlari va belgilari",
        "fontSize": 40,
        "maxCharacters": 27,
        "elementIndex": 3
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 224.64881889763777,
        "content": "O'sma turlari hayvonlar va o'simliklar dunyosida uchraydi.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 5
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 676.7618897637794,
        "top": 159.58414698162727,
        "content": "Ularning ayrimlari xasiyatlari bilan ajralib turadi.",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 7
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 411.93784776902885,
        "content": "O'sma turlari ko'plab rang va shakllarda bo'ladi.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 9
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 680.4828346456692,
        "top": 347.24094488188973,
        "content": "O'simliklarga xos bo'lgan o'smalar ko'proq uchraydi.",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 11
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 211.92787401574802,
        "content": "Hayvonlar o'smalari odatda kamroq uchraydi.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 13
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 63.03128608923883,
        "top": 152.95191601049868,
        "content": "O'smalar o'simliklar hayotida muhim rol o'ynaydi.",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 15
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 405.93784776902885,
        "content": "Ular ko'payish va yashash jarayonida ishtirok etadi.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 17
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 50.62813648293963,
        "top": 347.24094488188973,
        "content": "O'sma turlari tabiiy muvozanatni saqlashda yordam beradi.",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 19
      }
    ],
    "note": ""
  },
  {
    "id": "yzf1oPwqfC",
