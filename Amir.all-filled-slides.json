      {
        "type": "shape",
        "width": 776.4724409448818,
        "height": 58,
        "left": 91.76293963254592,
        "top": 20.76850393700787,
        "content": "Nerv tizimi o'smalari",
        "fontSize": 40,
        "maxCharacters": 32,
        "elementIndex": 26
      },
      {
        "type": "shape",
        "width": 238.25102362204723,
        "height": 63.390656167978996,
        "left": 68.36514435695537,
        "top": 155.26225721784775,
        "content": "Nerv tizimi o'smalari asosan miyaning, orqa miya va nerv tolalarining o'smalari bo'lib, ularning har biri turli xil simptomlar va muammolarni keltirib chiqarishi mumkin.",
        "fontSize": 13,
        "maxCharacters": 120,
        "elementIndex": 28
      },
      {
        "type": "shape",
        "width": 232.7155905511811,
        "height": 63.390656167978996,
        "left": 355.4745406824146,
        "top": 161.46383202099736,
        "content": "O'smalar benign yoki malign bo'lishi mumkin, benign o'smalar ko'pincha zarar yetkazmasa-da, malign o'smalar hayot uchun xavf tug'dirishi mumkin.",
        "fontSize": 13,
        "maxCharacters": 116,
        "elementIndex": 30
      },
      {
        "type": "shape",
        "width": 233.99611548556427,
        "height": 63.390656167978996,
        "left": 654.5164304461941,
        "top": 167.66540682414697,
        "content": "Davolash usullari orasida jarrohlik, radioterapiya va kimyoterapiya mavjud. Har bir holatga qarab, eng samarali usul tanlanadi.",
        "fontSize": 13,
        "maxCharacters": 116,
        "elementIndex": 32
      }
    ],
    "note": ""
  },
