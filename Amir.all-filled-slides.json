      },
      {
        "type": "image",
        "src": "https://newsnetwork.mayoclinic.org/n7-mcnn/7bcc9724adf7b803/uploads/2018/06/a-medical-illustration-of-glioma-original.jpg",
        "hasImage": true,
        "elementIndex": 1
      },
      {
        "type": "image",
