      {
        "type": "shape",
        "width": 347.51128608923887,
        "height": 63.390656167978996,
        "left": 132.48871391076113,
        "top": 423.92881889763777,
        "content": "Nerv tizimi o'smalarini davolashda muhim omillar: diagnostika, jarrohlik, radioterapiya va kimyoterapiya. Ularning har biri bemorning holatiga qarab tanlanadi.",
        "fontSize": 13,
        "maxCharacters": 176,
        "elementIndex": 16
      },
      {
        "type": "shape",
        "width": 384.32839895013115,
        "height": 63.390656167978996,
        "left": 549.3974803149606,
        "top": 423.92881889763777,
        "content": "Jarrohlikdan keyin tiklanish jarayonida bemorlar uchun reabilitatsiya dasturlari ishlab chiqiladi. Bu dastur bemorning holatini yaxshilashga yordam beradi va hayot sifatini oshiradi.",
        "fontSize": 13,
        "maxCharacters": 196,
