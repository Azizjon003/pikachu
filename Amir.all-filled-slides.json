        "left": 147.13721784776902,
        "top": 16.931653543307085,
        "content": "Tumor tasnifi asoslari",
        "fontSize": 40,
        "maxCharacters": 27,
        "elementIndex": 3
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 224.64881889763777,
        "content": "Tumorlar o'sish joyi va xususiyatlariga qarab tasniflanadi. Har bir turli xil tumor o'ziga xos klinik ko'rinishga ega.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 5
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 676.7618897637794,
        "top": 159.58414698162727,
        "content": "Tumor turlari",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 7
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 684.2036745406823,
        "top": 411.93784776902885,
        "content": "Tumorlar benign va malign bo'lishi mumkin. Benign tumorlar ko'pincha xavfsizdir.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 9
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 680.4828346456692,
        "top": 347.24094488188973,
        "content": "Tasniflashda usullar",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 11
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 211.92787401574802,
        "content": "Tumorlar histologik tuzilishi va genetik xususiyatlariga qarab tasniflanadi.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 13
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 63.03128608923883,
        "top": 152.95191601049868,
        "content": "Qayta tekshirish va monitoring",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 15
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 36.695328083989494,
        "left": 63.03128608923883,
        "top": 405.93784776902885,
        "content": "Tumorlarni davolashda ularning tasnifi muhim ahamiyatga ega.",
        "fontSize": 13,
        "maxCharacters": 54,
        "elementIndex": 17
      },
      {
        "type": "shape",
        "width": 212.77165354330705,
        "height": 25.343727034120732,
        "left": 50.62813648293963,
        "top": 347.24094488188973,
        "content": "Klinik tashxis va davolash rejalashtirish uchun zarur.",
        "fontSize": 15,
        "maxCharacters": 23,
        "elementIndex": 19
      }
    ],
    "note": ""
