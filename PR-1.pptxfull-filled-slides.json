        "maxCharacters": 372,
        "elementIndex": 10
      },
      {
        "type": "shape",
        "width": 349.6288713910761,
        "height": 261.76566929133855,
        "left": 542.6245669291338,
        "top": 173.49165354330708,
        "content": "Googlening ta'siri, ta'lim, iqtisodiyot va ijtimoiy hayotda sezilarli. Odamlar uchun yangi bilimlar, ko'nikmalar va ish o'rinlarini yaratishga yordam beradi. Shuningdek, Google mahsulotlari, masalan, Google Maps va Google Drive, kundalik hayotimizda muhim rol o'ynaydi.",
        "fontSize": 18.5,
        "maxCharacters": 409,
