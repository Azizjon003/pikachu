    {
      "elementIndex": 7,
      "content": "O'smalar odam organizmida xavfli o'simta bo'lishi mumkin. Ular tez o'sishi, metastaz berishi va sog'liqni yomonlashtirishi mumkin.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 8,
      "content": "O'smalarni erta aniqlash muhimdir. Shifokorlar muntazam tibbiy ko'riklar o'tkazib turishlari zarur.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 9,
      "content": "O'smalarning oldini olish uchun sog'lom turmush tarzini saqlash va zararli odatlardan qochish kerak.",
      "tableData": {
        "data": []
      }
    },
    {
      "elementIndex": 10,
      "content": "O'smalarning xavfi haqida xabardor bo'lishimiz zarur.",
      "tableData": {
        "data": []
      }
    },
    {
