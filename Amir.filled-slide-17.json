    {
      "type": "shape",
      "content": "Nerv tizimi o'smalarini davolash usullari",
      "elementIndex": 15
    },
    {
      "type": "shape",
      "content": "Nerv tizimida o'smalarni davolash murakkab jarayon bo'lib, bir qancha usullarni o'z ichiga oladi. Ushbu usullar orasida jarrohlik, radioterapiya va kimyoterapiya mavjud.",
      "elementIndex": 17
    },
    {
      "type": "shape",
      "content": "Jarrohlik usuli",
      "elementIndex": 19
    },
    {
      "type": "shape",
      "content": "Jarrohlik usuli nerv tizimidagi o'smalarni olib tashlashda eng samarali usullardan biridir. O'sma joylashuvi va o'lchamiga qarab, turli xil jarrohlik usullari qo'llanilishi mumkin.",
      "elementIndex": 21
    },
    {
      "type": "shape",
      "content": "Radioterapiya",
      "elementIndex": 23
    },
    {
      "type": "shape",
      "content": "Radioterapiya o'smalarni yo'q qilish uchun yuqori energiyali nurlardan foydalanadi. Bu usul asosan jarrohlikdan keyin qo'llaniladi yoki o'sma operatsiya qilish mumkin bo'lmagan joylarda ishlatiladi.",
      "elementIndex": 25
    },
    {
      "type": "shape",
      "content": "Kimyoterapiya",
      "elementIndex": 27
    },
    {
      "type": "shape",
      "content": "Kimyoterapiya o'sma hujayralarini yo'q qilish uchun dori-darmonlardan foydalanadi. Bu usul o'sma tarqalgan hollarda qo'llaniladi.",
      "elementIndex": 29
    },
    {
      "type": "shape",
      "content": "Reabilitatsiya va qo'shimcha usullar",
      "elementIndex": 31
    }
